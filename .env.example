# 配置说明：本文件含敏感信息，请勿提交 Git；修改后需重启原生服务或重新创建 Compose 容器。
# Never commit a real database password.
# PostgreSQL 主机地址；必须能从控制面进程或容器访问。
PYSCRIPTS_DATABASE_HOST=192.168.0.11
# PostgreSQL 监听端口，默认 5432。
PYSCRIPTS_DATABASE_PORT=5432
# 数据库名称；需要提前创建，平台初始化只负责建表。
PYSCRIPTS_DATABASE_NAME=pyscripts
# 数据库账号；需具备业务表读写及初始化/升级所需权限。
PYSCRIPTS_DATABASE_USER=pyscripts_adm
# 数据库密码；勿提交 Git，含 $ 等特殊字符时使用 dotenv 单引号。
PYSCRIPTS_DATABASE_PASSWORD=replace-me

# Ray 连接地址；集群内用 Service:10001，集群外用可达且受保护的 Ray Client 入口。
PYSCRIPTS_RAY_ADDRESS=ray://pyscripts-ray-head-svc.pyscripts.svc.cluster.local:10001
# Ray 命名空间，用于隔离和查找 Actor；不是 Kubernetes Namespace。
PYSCRIPTS_RAY_NAMESPACE=pyscripts
# 是否强制按 Ray 节点标签调度；KubeRay 部署启用，本地无标签测试可关闭。
PYSCRIPTS_RAY_USE_LABEL_SELECTOR=true
# 容器层 Worker Pool 的 Ray 节点标签键，必须与 KubeRay 配置一致。
PYSCRIPTS_RAY_WORKER_POOL_LABEL_KEY=pyscripts.worker-pool
# 节点唯一身份标签键，用于 Compute 优先调度到已预热节点。
PYSCRIPTS_RAY_NODE_ID_LABEL_KEY=ray.io/node-id
# 无标签本地模式提供的默认 Worker 类型名；不会创建 Kubernetes Worker。
PYSCRIPTS_DEFAULT_WORKER_POOL=default
# 需要读取的 RayCluster 名称；控制面在集群内有读取权限时用于发现所有声明的 Pool。
PYSCRIPTS_KUBERAY_CLUSTER_NAME=pyscripts-ray
# RayCluster 所在 Kubernetes Namespace，用于 Worker Pool 发现。
PYSCRIPTS_KUBERNETES_NAMESPACE=pyscripts
# Runtime Env 安装和初始化超时，单位秒；不等于业务请求执行超时。
PYSCRIPTS_RUNTIME_ENV_SETUP_TIMEOUT_SECONDS=900
# 是否要求发布引用已注册且可用的运行环境；正常部署保持 true。
PYSCRIPTS_REQUIRE_REGISTERED_RUNTIME_PROFILES=true
# 每个运行环境的 IO Actor 数量上限；增加前先确认 Worker 资源容量。
PYSCRIPTS_ACTOR_MAX_PER_PROFILE=8
# 单个 IO Actor 的最大并发数；同步 CPU 密集工作不应靠提高此值处理。
PYSCRIPTS_ACTOR_MAX_IO=100
# IO Actor 提前扩容的目标并发数，不能超过 ACTOR_MAX_IO。
PYSCRIPTS_ACTOR_TARGET_IO_CONCURRENCY=50
# A profile becomes hot at 5 requests in the default 10-second window.
# 环境进入 Hot 的请求频率阈值，单位次/秒；默认窗口 10 秒内 5 次约为 0.5。
PYSCRIPTS_ACTOR_HOT_REQUEST_RATE=0.5
# 请求频率统计的滑动窗口长度，单位秒。
PYSCRIPTS_ACTOR_REQUEST_RATE_WINDOW_SECONDS=10
# 高需求环境预留的 Warm Actor 目标数量；仍受每环境 Actor 总上限限制。
PYSCRIPTS_ACTOR_WARM_SPARES=1
# 执行耗时平滑系数，范围 (0,1]；越大越重视最近请求，用于估算扩容需求。
PYSCRIPTS_ACTOR_DURATION_EWMA_ALPHA=0.2
# 每个 IO Actor 申请的 Ray 逻辑 CPU 数；Actor 存活期间会占用调度资源。
PYSCRIPTS_ACTOR_NUM_CPUS=1
# 未被执行消费的 IO 预留租约有效期，单位秒；不是正在执行任务的时限。
PYSCRIPTS_ACTOR_LEASE_TTL_SECONDS=15
# 等待 IO 容量或 Compute 提交配额的最长时间，单位秒。
PYSCRIPTS_ACTOR_QUEUE_TIMEOUT_SECONDS=30
# Excess warm actors leave quickly; the final warm actor has a longer grace
# period and then scales to zero.
# 多余空闲 IO Actor 回收等待时间，单位秒；不回收正在执行请求的 Actor。
PYSCRIPTS_ACTOR_HOT_IDLE_TIMEOUT_SECONDS=300
# 最后一个空闲 Warm Actor 回收等待时间，单位秒；不得小于 HOT_IDLE_TIMEOUT。
PYSCRIPTS_ACTOR_WARM_IDLE_TIMEOUT_SECONDS=1800
# IO Actor 空闲回收检查周期，单位秒；实际回收时点受此周期影响。
PYSCRIPTS_ACTOR_REAPER_INTERVAL_SECONDS=15
# Compute Task 默认申请的 Ray 逻辑 CPU 数；Hook 的 num_cpus 可覆盖。
PYSCRIPTS_COMPUTE_TASK_NUM_CPUS=1
# Compute Task 默认申请的 Ray GPU 数；Hook 的 num_gpus 可覆盖，0 表示不申请。
PYSCRIPTS_COMPUTE_TASK_NUM_GPUS=0
# 每环境控制面同时持有的 Compute 请求配额上限；配额持有到任务结束。
PYSCRIPTS_COMPUTE_MAX_PENDING_PER_PROFILE=64
# 是否优先把 Compute 调度到相同环境已预热节点；回退仍不得跨 Worker Pool。
PYSCRIPTS_COMPUTE_PROFILE_AFFINITY=true
# 每环境记录的 Compute 预热节点数量上限；不是常驻 Worker 数量。
PYSCRIPTS_COMPUTE_WARM_NODES_PER_PROFILE=8
# 停用环境后等待执行器释放/清理完成的超时，单位秒。
PYSCRIPTS_RUNTIME_PROFILE_RETIREMENT_TIMEOUT_SECONDS=600
# 环境退休状态扫描和失败重试间隔，单位秒；启动时立即恢复 RETIRING 任务。
PYSCRIPTS_RUNTIME_PROFILE_RETIREMENT_RETRY_SECONDS=15
# 单次调用捕获 stdout/stderr 的总字节上限，默认 65536（64KiB）；超过会标记截断。
PYSCRIPTS_INVOCATION_LOG_MAX_BYTES=65536
# 捕获日志的分块大小，单位字节；不是日志行数或调用记录保留数量。
PYSCRIPTS_INVOCATION_LOG_CHUNK_BYTES=4096
# 是否同时捕获 Python 标准错误流；stdout 的捕获不由此项关闭。
PYSCRIPTS_CAPTURE_STDERR=true

# Optional platform-managed private package index. Runtime labels select either
# "default" or "private"; credentials are never persisted in PostgreSQL.
# 平台私有 PyPI 主源，可带 URL 编码凭据；仅存部署配置，Worker 必须可达。
# PYSCRIPTS_PRIVATE_PIP_INDEX_URL=https://user:password@pypi.example.com/simple
# List-valued settings use JSON syntax.
# 私有源的附加索引 URL 列表，使用 JSON 数组；混用公共源需防范依赖混淆。
PYSCRIPTS_PRIVATE_PIP_EXTRA_INDEX_URLS=[]
# 允许 pip 信任的主机列表，使用 JSON 数组；仅填受信任内网主机，优先 HTTPS。
PYSCRIPTS_PRIVATE_PIP_TRUSTED_HOSTS=[]

# Public API origin used to generate repository webhook URLs. Set this when the
# API is behind a reverse proxy; do not add a trailing slash.
# 用于生成外部 Webhook 链接的 HTTP(S) 根地址；反向代理部署时填写实际域名，不带末尾 /。
# PYSCRIPTS_PUBLIC_BASE_URL=https://pyscripts.example.com
# Git Webhook 请求体的最大字节数，默认 1048576（1MiB）。
PYSCRIPTS_WEBHOOK_MAX_BODY_BYTES=1048576

# Single administrator account. Use a unique password and a random session
# signing secret of at least 32 characters. Enable secure cookies behind HTTPS.
# 首次启动且数据库无管理员记录时使用的初始密码；修改此项不会重置已有密码。
PYSCRIPTS_ADMIN_PASSWORD=replace-with-a-strong-password
# 管理员 Cookie 签名密钥，至少 32 个随机字符；保持稳定，变更会使旧登录失效。
PYSCRIPTS_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# 管理员登录会话有效期，单位秒；默认 28800（8 小时）。
PYSCRIPTS_ADMIN_SESSION_TTL_SECONDS=28800
# 是否仅通过 HTTPS 发送登录 Cookie；HTTP 测试用 false，HTTPS 生产入口用 true。
PYSCRIPTS_ADMIN_COOKIE_SECURE=false

# S3-compatible immutable business artifact storage. Endpoint must be reachable
# by the API server; generated presigned URLs must also be reachable by Ray workers.
# 是否将业务 ZIP、Proto 和 Descriptor 持久化到 S3；远程执行正常部署应启用。
PYSCRIPTS_OBJECT_STORE_ENABLED=true
# S3 API 地址，不是管理页面端口；控制面与 Ray Worker 都必须可达。
PYSCRIPTS_OBJECT_STORE_ENDPOINT_URL=http://object-store.example.internal:9000
# S3 签名使用的区域名，须与对象存储服务配置兼容。
PYSCRIPTS_OBJECT_STORE_REGION=us-east-1
# 对象存储 Bucket 名称；需要提前创建，平台不会自动创建。
PYSCRIPTS_OBJECT_STORE_BUCKET=pyscripts
# 业务 ZIP 和契约文件的对象键前缀；不要随意删除仍被 Revision 引用的对象。
PYSCRIPTS_OBJECT_STORE_ARTIFACT_PREFIX=pyscripts/artifacts
# S3 Access Key；使用专用最小权限凭据，不传给业务调用者。
PYSCRIPTS_OBJECT_STORE_ACCESS_KEY_ID=replace-me
# S3 Secret Key；仅存部署配置，不提交 Git，也不直接传给 Ray Worker。
PYSCRIPTS_OBJECT_STORE_SECRET_ACCESS_KEY=replace-me
# 可选 S3 临时凭据 Session Token；使用长期 Access Key 时通常不填写。
# PYSCRIPTS_OBJECT_STORE_SESSION_TOKEN=
# S3 寻址方式：path 或 virtual；普通内网兼容服务通常使用 path。
PYSCRIPTS_OBJECT_STORE_ADDRESSING_STYLE=path
# 控制面是否校验 S3 HTTPS 证书；生产保持 true，Worker 也需要信任下载地址证书。
PYSCRIPTS_OBJECT_STORE_VERIFY_SSL=true
# 预签名下载 URL 的有效期，单位秒；默认 3600，URL 不作为持久化文件地址。
PYSCRIPTS_OBJECT_STORE_PRESIGN_TTL_SECONDS=3600
# 控制面连接 S3 的超时，单位秒。
PYSCRIPTS_OBJECT_STORE_CONNECT_TIMEOUT_SECONDS=10
# 控制面读取 S3 响应的超时，单位秒。
PYSCRIPTS_OBJECT_STORE_READ_TIMEOUT_SECONDS=120

# 是否启动业务 gRPC 网关；关闭不影响 REST 监听。
PYSCRIPTS_GRPC_ENABLED=true
# 原生运行时 gRPC 的监听地址；Compose 覆盖为 0.0.0.0。
PYSCRIPTS_GRPC_HOST=0.0.0.0
# 原生运行时 gRPC 的监听端口；Compose 内部固定覆盖为 50051。
PYSCRIPTS_GRPC_PORT=50051
# gRPC 路由快照的周期刷新间隔，单位秒；发布操作也会主动刷新。
PYSCRIPTS_GRPC_ROUTE_REFRESH_SECONDS=5
# gRPC 单条接收消息上限，单位字节；默认 4194304（4MiB），客户端限制也需匹配。
PYSCRIPTS_GRPC_MAX_RECEIVE_MESSAGE_BYTES=4194304
# gRPC 单条发送消息上限，单位字节；默认 4194304（4MiB），大 ArrowTable 需另评估内存。
PYSCRIPTS_GRPC_MAX_SEND_MESSAGE_BYTES=4194304

# 本地 Proto/Descriptor 构建缓存目录，不是持久化存储；已发布契约存入 S3，Compose 覆盖此路径。
PYSCRIPTS_CONTRACT_CACHE_ROOT=/tmp/pyscripts-contracts

# 是否由 FastAPI 托管编译后的 Web UI；启用时仍需要存在构建产物。
PYSCRIPTS_SERVE_UI=true
# Web UI 构建产物目录；原生部署通常为 ui/dist，Compose 覆盖为 /app/ui/dist。
PYSCRIPTS_UI_DIST_PATH=ui/dist
